# ==========================================
# O'BARBA SALON - ENVIRONMENT VARIABLES
# ==========================================
# Is file ko copy karke .env naam do
# Apni values fill karo

# MongoDB Atlas Connection String
# mongodb.com pe free account banao
MONGODB_URI=mongodb+srv://obarba:Obarba@0501@cluster.mongodb.net/obarba?retryWrites=true&w=majority

# Server Port (Render automatically set karta hai)
PORT=3000

# Admin Panel Password (apna password set karo)
ADMIN_PASSWORD=Obarba@0501

# ==========================================
# WhatsApp Notification (CallMeBot - FREE)
# ==========================================
# Steps:
# 1. Apne WhatsApp se is number pe msg karo: +34 644 59 95 85
# 2. Message: "I allow callmebot to send me messages"
# 3. Aapko API key milegi reply mein
# 4. Wo key yahan paste karo

WHATSAPP_PHONE=91XXXXXXXXXX     # Apna number (country code ke saath, +/- nahi)
WHATSAPP_API_KEY=XXXXXXXX       # CallMeBot se mili API key

# ==========================================
# Frontend URL (CORS ke liye)
# ==========================================
FRONTEND_URL=https://obarbafamilysalon.com
