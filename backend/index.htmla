<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>O'BARBA Admin Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  :root{
    --gold:#D4AF37;--gold-light:#E8C94A;--gold-dark:#B8962E;
    --dark:#0B0B0B;--dark-light:#121212;--dark-mid:#1A1A1A;
    --dark-card:#161616;--charcoal:#2A2A2A;
    --green:#22c55e;--red:#ef4444;--blue:#3b82f6;--yellow:#f59e0b;
  }
  html{scroll-behavior:smooth;}
  body{background:var(--dark);color:#E5E5E5;font-family:'Inter',sans-serif;min-height:100vh;}
  ::-webkit-scrollbar{width:5px;}
  ::-webkit-scrollbar-track{background:var(--dark);}
  ::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px;}

  /* ---- LOGIN SCREEN ---- */
  #loginScreen{
    position:fixed;inset:0;background:var(--dark);
    display:flex;align-items:center;justify-content:center;z-index:1000;
  }
  .login-box{
    width:100%;max-width:400px;padding:48px 40px;
    background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;text-align:center;
  }
  .login-logo{font-family:'Playfair Display',serif;font-size:28px;color:var(--gold);margin-bottom:6px;}
  .login-sub{font-size:11px;letter-spacing:3px;color:rgba(212,175,55,0.5);text-transform:uppercase;margin-bottom:36px;}
  .login-input{
    width:100%;padding:14px 16px;margin-bottom:16px;
    background:var(--dark);border:1px solid var(--charcoal);
    color:#fff;font-size:14px;border-radius:2px;outline:none;
    transition:border .3s;
  }
  .login-input:focus{border-color:var(--gold);}
  .login-btn{
    width:100%;padding:14px;background:var(--gold);color:var(--dark);
    font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;
    border:none;cursor:pointer;border-radius:2px;transition:background .3s;
  }
  .login-btn:hover{background:var(--gold-light);}
  .login-error{color:#ef4444;font-size:13px;margin-top:12px;display:none;}

  /* ---- MAIN LAYOUT ---- */
  #mainApp{display:none;}
  .sidebar{
    position:fixed;left:0;top:0;bottom:0;width:240px;
    background:var(--dark-light);border-right:1px solid var(--charcoal);
    display:flex;flex-direction:column;z-index:100;
  }
  .sidebar-logo{padding:24px 20px 20px;border-bottom:1px solid var(--charcoal);}
  .sidebar-logo .brand{font-family:'Playfair Display',serif;color:var(--gold);font-size:18px;}
  .sidebar-logo .sub{font-size:9px;letter-spacing:3px;color:rgba(212,175,55,0.4);text-transform:uppercase;}
  .sidebar-nav{flex:1;padding:16px 0;}
  .nav-item{
    display:flex;align-items:center;gap:12px;
    padding:12px 20px;color:rgba(255,255,255,0.5);
    text-decoration:none;font-size:13px;font-weight:500;
    cursor:pointer;transition:all .2s;border-left:3px solid transparent;
  }
  .nav-item:hover,.nav-item.active{color:var(--gold);background:rgba(212,175,55,0.06);border-left-color:var(--gold);}
  .nav-item i{width:16px;text-align:center;}
  .sidebar-logout{
    padding:20px;border-top:1px solid var(--charcoal);
    display:flex;align-items:center;gap:10px;
    color:rgba(255,255,255,0.4);font-size:13px;cursor:pointer;
    transition:color .2s;
  }
  .sidebar-logout:hover{color:var(--red);}

  .main-content{margin-left:240px;min-height:100vh;padding:32px;}

  /* ---- TOP BAR ---- */
  .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;}
  .topbar h1{font-family:'Playfair Display',serif;font-size:26px;color:#fff;}
  .topbar .date-badge{
    padding:8px 16px;background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:20px;font-size:12px;color:rgba(255,255,255,0.5);
  }

  /* ---- STATS CARDS ---- */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:32px;}
  .stat-card{
    padding:20px;background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;transition:border-color .3s;
  }
  .stat-card:hover{border-color:rgba(212,175,55,0.3);}
  .stat-icon{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:12px;font-size:14px;}
  .stat-value{font-family:'Playfair Display',serif;font-size:28px;color:#fff;font-weight:700;}
  .stat-label{font-size:11px;color:rgba(255,255,255,0.4);letter-spacing:1px;text-transform:uppercase;margin-top:4px;}
  .gold-icon{background:rgba(212,175,55,0.1);color:var(--gold);}
  .green-icon{background:rgba(34,197,94,0.1);color:var(--green);}
  .yellow-icon{background:rgba(245,158,11,0.1);color:var(--yellow);}
  .red-icon{background:rgba(239,68,68,0.1);color:var(--red);}
  .blue-icon{background:rgba(59,130,246,0.1);color:var(--blue);}

  /* ---- FILTERS ---- */
  .filters-bar{
    display:flex;flex-wrap:wrap;gap:12px;align-items:center;
    padding:16px 20px;background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;margin-bottom:20px;
  }
  .filter-select,.filter-input{
    padding:9px 14px;background:var(--dark);border:1px solid var(--charcoal);
    color:#fff;font-size:13px;border-radius:2px;outline:none;transition:border .3s;
  }
  .filter-select:focus,.filter-input:focus{border-color:var(--gold);}
  .filter-btn{
    padding:9px 20px;background:var(--gold);color:var(--dark);
    font-weight:700;font-size:12px;letter-spacing:1px;text-transform:uppercase;
    border:none;cursor:pointer;border-radius:2px;transition:background .3s;
  }
  .filter-btn:hover{background:var(--gold-light);}
  .reset-btn{
    padding:9px 16px;background:transparent;color:rgba(255,255,255,0.4);
    font-size:12px;border:1px solid var(--charcoal);cursor:pointer;border-radius:2px;
    transition:all .3s;
  }
  .reset-btn:hover{color:#fff;border-color:rgba(255,255,255,0.3);}
  .total-badge{
    margin-left:auto;font-size:12px;color:rgba(255,255,255,0.5);
    background:var(--dark);padding:6px 14px;border-radius:20px;border:1px solid var(--charcoal);
  }

  /* ---- BOOKINGS TABLE ---- */
  .table-container{
    background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;overflow:hidden;
  }
  .table-header{
    padding:16px 20px;border-bottom:1px solid var(--charcoal);
    display:flex;align-items:center;justify-content:space-between;
  }
  .table-title{font-size:14px;font-weight:600;color:#fff;}
  .refresh-btn{
    padding:7px 14px;background:transparent;color:var(--gold);
    border:1px solid rgba(212,175,55,0.3);font-size:12px;
    cursor:pointer;border-radius:2px;transition:all .3s;
  }
  .refresh-btn:hover{background:rgba(212,175,55,0.1);}

  .bookings-table{width:100%;border-collapse:collapse;}
  .bookings-table th{
    padding:12px 16px;text-align:left;font-size:10px;
    letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);
    border-bottom:1px solid var(--charcoal);background:var(--dark-mid);
  }
  .bookings-table td{
    padding:14px 16px;font-size:13px;border-bottom:1px solid rgba(42,42,42,0.5);
    vertical-align:middle;
  }
  .bookings-table tr:hover td{background:rgba(212,175,55,0.03);}
  .bookings-table tr:last-child td{border-bottom:none;}

  .customer-name{font-weight:600;color:#fff;}
  .customer-phone{font-size:12px;color:var(--gold);margin-top:2px;}

  /* Status Badges */
  .badge{
    display:inline-flex;align-items:center;gap:5px;
    padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;
    letter-spacing:0.5px;text-transform:uppercase;
  }
  .badge-dot{width:6px;height:6px;border-radius:50%;}
  .badge.pending{background:rgba(245,158,11,0.12);color:var(--yellow);}
  .badge.pending .badge-dot{background:var(--yellow);}
  .badge.confirmed{background:rgba(59,130,246,0.12);color:var(--blue);}
  .badge.confirmed .badge-dot{background:var(--blue);}
  .badge.completed{background:rgba(34,197,94,0.12);color:var(--green);}
  .badge.completed .badge-dot{background:var(--green);}
  .badge.cancelled{background:rgba(239,68,68,0.12);color:var(--red);}
  .badge.cancelled .badge-dot{background:var(--red);}

  /* Action Buttons */
  .action-btns{display:flex;gap:6px;}
  .act-btn{
    width:30px;height:30px;border-radius:4px;border:1px solid;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;font-size:12px;transition:all .2s;background:transparent;
  }
  .act-confirm{border-color:rgba(59,130,246,0.3);color:var(--blue);}
  .act-confirm:hover{background:rgba(59,130,246,0.1);}
  .act-complete{border-color:rgba(34,197,94,0.3);color:var(--green);}
  .act-complete:hover{background:rgba(34,197,94,0.1);}
  .act-cancel{border-color:rgba(239,68,68,0.3);color:var(--red);}
  .act-cancel:hover{background:rgba(239,68,68,0.1);}
  .act-delete{border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.3);}
  .act-delete:hover{background:rgba(239,68,68,0.1);border-color:rgba(239,68,68,0.3);color:var(--red);}

  /* Empty state */
  .empty-state{padding:60px 20px;text-align:center;}
  .empty-state i{font-size:40px;color:rgba(212,175,55,0.2);margin-bottom:16px;}
  .empty-state p{color:rgba(255,255,255,0.3);font-size:14px;}

  /* Loading */
  .loading{padding:40px;text-align:center;color:rgba(255,255,255,0.3);}
  .spinner{
    display:inline-block;width:24px;height:24px;
    border:2px solid rgba(212,175,55,0.2);border-top-color:var(--gold);
    border-radius:50%;animation:spin .8s linear infinite;margin-bottom:12px;
  }
  @keyframes spin{to{transform:rotate(360deg);}}

  /* Toast */
  .toast{
    position:fixed;top:24px;right:24px;z-index:9999;
    padding:14px 20px;border-radius:4px;font-size:13px;font-weight:500;
    background:var(--dark-mid);border:1px solid var(--gold);color:var(--gold);
    transform:translateX(120%);transition:transform .4s;min-width:260px;
    display:flex;align-items:center;gap:10px;
  }
  .toast.show{transform:translateX(0);}
  .toast.success{border-color:var(--green);color:var(--green);}
  .toast.error{border-color:var(--red);color:var(--red);}

  /* Modal */
  .modal-backdrop{
    position:fixed;inset:0;background:rgba(0,0,0,0.8);
    backdrop-filter:blur(8px);z-index:500;display:none;
    align-items:center;justify-content:center;
  }
  .modal-backdrop.open{display:flex;}
  .modal{
    background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;padding:32px;width:100%;max-width:480px;
    position:relative;
  }
  .modal h3{font-family:'Playfair Display',serif;font-size:20px;color:#fff;margin-bottom:20px;}
  .modal-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:8px;display:block;}
  .modal-select,.modal-textarea{
    width:100%;padding:10px 14px;background:var(--dark);border:1px solid var(--charcoal);
    color:#fff;font-size:13px;border-radius:2px;outline:none;
    transition:border .3s;margin-bottom:16px;
  }
  .modal-select:focus,.modal-textarea:focus{border-color:var(--gold);}
  .modal-textarea{min-height:80px;resize:vertical;font-family:inherit;}
  .modal-btns{display:flex;gap:10px;justify-content:flex-end;}
  .modal-cancel{padding:10px 20px;background:transparent;color:rgba(255,255,255,0.5);border:1px solid var(--charcoal);cursor:pointer;border-radius:2px;font-size:13px;}
  .modal-save{padding:10px 24px;background:var(--gold);color:var(--dark);border:none;font-weight:700;font-size:13px;cursor:pointer;border-radius:2px;}
  .modal-close{position:absolute;top:16px;right:16px;background:none;border:none;color:rgba(255,255,255,0.4);font-size:18px;cursor:pointer;}

  /* Page sections */
  .page-section{display:none;}
  .page-section.active{display:block;}

  /* Responsive */
  @media(max-width:900px){
    .sidebar{transform:translateX(-100%);transition:transform .3s;}
    .sidebar.open{transform:translateX(0);}
    .main-content{margin-left:0;}
    .stats-grid{grid-template-columns:repeat(2,1fr);}
    .bookings-table{font-size:12px;}
    .bookings-table th:nth-child(5),.bookings-table td:nth-child(5){display:none;}
  }
  @media(max-width:600px){
    .main-content{padding:20px;}
    .stats-grid{grid-template-columns:1fr 1fr;}
    .bookings-table th:nth-child(4),.bookings-table td:nth-child(4){display:none;}
  }

  /* WhatsApp section */
  .info-card{
    padding:20px;background:var(--dark-card);border:1px solid var(--charcoal);
    border-radius:4px;margin-bottom:16px;
  }
  .info-card h4{color:var(--gold);font-size:14px;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
  .info-card p,.info-card li{color:rgba(255,255,255,0.6);font-size:13px;line-height:1.8;}
  .info-card ol,.info-card ul{padding-left:20px;}
  .step-badge{
    display:inline-block;width:22px;height:22px;background:var(--gold);
    color:var(--dark);border-radius:50%;text-align:center;line-height:22px;
    font-size:11px;font-weight:700;margin-right:8px;
  }
  .code-box{
    background:var(--dark);border:1px solid var(--charcoal);
    padding:12px 16px;border-radius:2px;font-family:monospace;
    font-size:13px;color:var(--gold);margin:10px 0;
  }
</style>
</head>
<body>

<!-- Toast -->
<div id="toast" class="toast"><i id="toastIcon"></i><span id="toastMsg"></span></div>

<!-- Status Update Modal -->
<div class="modal-backdrop" id="statusModal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
    <h3>Update Booking</h3>
    <input type="hidden" id="editBookingId">
    <label class="modal-label">Status</label>
    <select id="editStatus" class="modal-select">
      <option value="pending">⏳ Pending</option>
      <option value="confirmed">✅ Confirmed</option>
      <option value="completed">🌟 Completed</option>
      <option value="cancelled">❌ Cancelled</option>
    </select>
    <label class="modal-label">Notes (optional)</label>
    <textarea id="editNotes" class="modal-textarea" placeholder="Koi note likhna ho toh..."></textarea>
    <div class="modal-btns">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-save" onclick="saveStatus()">Save Changes</button>
    </div>
  </div>
</div>

<!-- ===== LOGIN SCREEN ===== -->
<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">O'BARBA</div>
    <div class="login-sub">Admin Panel</div>
    <input type="password" id="loginPass" class="login-input" placeholder="Password enter karo" onkeydown="if(event.key==='Enter')doLogin()">
    <button class="login-btn" onclick="doLogin()">
      <i class="fas fa-unlock-alt"></i> Login
    </button>
    <div class="login-error" id="loginError">❌ Galat password!</div>
  </div>
</div>

<!-- ===== MAIN APP ===== -->
<div id="mainApp">
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="brand">O'BARBA</div>
      <div class="sub">Admin Panel</div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-item active" onclick="showPage('dashboard')" id="nav-dashboard">
        <i class="fas fa-chart-line"></i> Dashboard
      </div>
      <div class="nav-item" onclick="showPage('bookings')" id="nav-bookings">
        <i class="fas fa-calendar-check"></i> Bookings
      </div>
      <div class="nav-item" onclick="showPage('whatsapp')" id="nav-whatsapp">
        <i class="fab fa-whatsapp"></i> WhatsApp Setup
      </div>
    </nav>
    <div class="sidebar-logout" onclick="logout()">
      <i class="fas fa-sign-out-alt"></i> Logout
    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <div class="topbar">
      <h1 id="pageTitle">Dashboard</h1>
      <div class="date-badge" id="currentDate"></div>
    </div>

    <!-- ===== DASHBOARD PAGE ===== -->
    <div class="page-section active" id="page-dashboard">
      <div class="stats-grid" id="statsGrid">
        <div class="stat-card">
          <div class="stat-icon gold-icon"><i class="fas fa-calendar-alt"></i></div>
          <div class="stat-value" id="stat-total">—</div>
          <div class="stat-label">Total Bookings</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon yellow-icon"><i class="fas fa-clock"></i></div>
          <div class="stat-value" id="stat-pending">—</div>
          <div class="stat-label">Pending</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue-icon"><i class="fas fa-check-circle"></i></div>
          <div class="stat-value" id="stat-confirmed">—</div>
          <div class="stat-label">Confirmed</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green-icon"><i class="fas fa-star"></i></div>
          <div class="stat-value" id="stat-completed">—</div>
          <div class="stat-label">Completed</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon red-icon"><i class="fas fa-times-circle"></i></div>
          <div class="stat-value" id="stat-cancelled">—</div>
          <div class="stat-label">Cancelled</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon gold-icon"><i class="fas fa-sun"></i></div>
          <div class="stat-value" id="stat-today">—</div>
          <div class="stat-label">Aaj Ki Bookings</div>
        </div>
      </div>

      <!-- Recent Bookings preview -->
      <div class="table-container">
        <div class="table-header">
          <div class="table-title">Recent Bookings (Latest 10)</div>
          <button class="refresh-btn" onclick="loadDashboard()"><i class="fas fa-sync-alt"></i> Refresh</button>
        </div>
        <div id="recentBookingsBody">
          <div class="loading"><div class="spinner"></div><br>Loading...</div>
        </div>
      </div>
    </div>

    <!-- ===== BOOKINGS PAGE ===== -->
    <div class="page-section" id="page-bookings">
      <div class="filters-bar">
        <select class="filter-select" id="filterStatus" onchange="applyFilters()">
          <option value="all">Sab Status</option>
          <option value="pending">⏳ Pending</option>
          <option value="confirmed">✅ Confirmed</option>
          <option value="completed">🌟 Completed</option>
          <option value="cancelled">❌ Cancelled</option>
        </select>
        <select class="filter-select" id="filterBranch" onchange="applyFilters()">
          <option value="all">Sab Branches</option>
          <option>Chitaipur</option>
          <option>Shivpur</option>
          <option>Maldahiya</option>
          <option>Lanka</option>
          <option>Sigra (Ink by O'Barba)</option>
          <option>Mau</option>
          <option>Jaunpur</option>
          <option>Noida</option>
        </select>
        <input type="date" class="filter-input" id="filterDate" onchange="applyFilters()">
        <button class="reset-btn" onclick="resetFilters()"><i class="fas fa-times"></i> Reset</button>
        <div class="total-badge"><span id="bookingCount">0</span> bookings</div>
      </div>

      <div class="table-container">
        <div class="table-header">
          <div class="table-title">All Bookings</div>
          <button class="refresh-btn" onclick="loadAllBookings()"><i class="fas fa-sync-alt"></i> Refresh</button>
        </div>
        <div id="allBookingsBody">
          <div class="loading"><div class="spinner"></div><br>Loading...</div>
        </div>
      </div>
    </div>

    <!-- ===== WHATSAPP SETUP PAGE ===== -->
    <div class="page-section" id="page-whatsapp">
      <div class="info-card">
        <h4><i class="fab fa-whatsapp"></i> WhatsApp Notification Setup (FREE)</h4>
        <p style="margin-bottom:16px;">CallMeBot service se free WhatsApp alerts milenge har nayi booking pe!</p>
        <ol style="list-style:none;padding:0;">
          <li style="margin-bottom:12px;">
            <span class="step-badge">1</span>
            Apne WhatsApp se is number pe message karo:
            <div class="code-box">+34 644 59 95 85</div>
          </li>
          <li style="margin-bottom:12px;">
            <span class="step-badge">2</span>
            Ye exact message bhejo:
            <div class="code-box">I allow callmebot to send me messages</div>
          </li>
          <li style="margin-bottom:12px;">
            <span class="step-badge">3</span>
            Reply mein API key milegi — wo copy karo
          </li>
          <li style="margin-bottom:12px;">
            <span class="step-badge">4</span>
            Server ke <strong>.env</strong> file mein update karo:
            <div class="code-box">WHATSAPP_PHONE=91XXXXXXXXXX<br>WHATSAPP_API_KEY=XXXXXXXX</div>
          </li>
          <li>
            <span class="step-badge">5</span>
            Server restart karo — ab notifications aane lagenge! 🎉
          </li>
        </ol>
      </div>

      <div class="info-card">
        <h4><i class="fas fa-server"></i> Backend Server Status</h4>
        <p>Backend URL: <strong style="color:var(--gold)" id="backendUrl"></strong></p>
        <br>
        <button class="filter-btn" onclick="checkServerStatus()">
          <i class="fas fa-heartbeat"></i> Check Server Status
        </button>
        <div id="serverStatus" style="margin-top:12px;font-size:13px;"></div>
      </div>

      <div class="info-card">
        <h4><i class="fas fa-cloud-upload-alt"></i> Render.com pe Deploy Karne ke Steps</h4>
        <ol>
          <li>Render.com pe free account banao</li>
          <li>"New Web Service" click karo</li>
          <li>GitHub repo connect karo: <strong style="color:var(--gold)">akashss1920-lang/obarba-salon</strong></li>
          <li>Root directory: <strong style="color:var(--gold)">backend</strong></li>
          <li>Build Command: <strong style="color:var(--gold)">npm install</strong></li>
          <li>Start Command: <strong style="color:var(--gold)">npm start</strong></li>
          <li>Environment variables add karo (MONGODB_URI, ADMIN_PASSWORD, etc.)</li>
          <li>Deploy! ✅</li>
        </ol>
      </div>
    </div>

  </div><!-- end main-content -->
</div><!-- end mainApp -->

<script>
// ============================================================
// CONFIG
// ============================================================
// Yahan apna backend URL daalo (deploy hone ke baad update karna)
const BACKEND_URL = 'https://obarba-backend.onrender.com';
 
let authToken = null;
let allBookingsData = [];

// ============================================================
// LOGIN
// ============================================================
function doLogin() {
  const pass = document.getElementById('loginPass').value;
  if (!pass) return;

  fetch(`${BACKEND_URL}/api/admin/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: pass })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      authToken = data.token;
      localStorage.setItem('obarba_token', authToken);
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('mainApp').style.display = 'block';
      setDate();
      loadDashboard();
    } else {
      document.getElementById('loginError').style.display = 'block';
    }
  })
  .catch(() => {
    document.getElementById('loginError').textContent = '❌ Server se connect nahi hua! Backend chal raha hai?';
    document.getElementById('loginError').style.display = 'block';
  });
}

// Auto-login if token saved
window.onload = () => {
  const saved = localStorage.getItem('obarba_token');
  if (saved) {
    authToken = saved;
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('mainApp').style.display = 'block';
    setDate();
    loadDashboard();
  }
  document.getElementById('backendUrl').textContent = BACKEND_URL;
};

function logout() {
  localStorage.removeItem('obarba_token');
  authToken = null;
  location.reload();
}

// ============================================================
// PAGE NAVIGATION
// ============================================================
function showPage(page) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(`page-${page}`).classList.add('active');
  document.getElementById(`nav-${page}`).classList.add('active');

  const titles = { dashboard: 'Dashboard', bookings: 'All Bookings', whatsapp: 'WhatsApp Setup' };
  document.getElementById('pageTitle').textContent = titles[page];

  if (page === 'bookings') loadAllBookings();
}

function setDate() {
  const d = new Date();
  document.getElementById('currentDate').textContent = d.toLocaleDateString('hi-IN', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });
}

// ============================================================
// LOAD DASHBOARD
// ============================================================
async function loadDashboard() {
  try {
    const res = await fetch(`${BACKEND_URL}/api/admin/bookings?limit=10`, {
      headers: { 'Authorization': authToken }
    });
    const data = await res.json();
    if (!data.success) { logout(); return; }

    // Stats
    const s = data.stats;
    document.getElementById('stat-total').textContent = s.total;
    document.getElementById('stat-pending').textContent = s.pending;
    document.getElementById('stat-confirmed').textContent = s.confirmed;
    document.getElementById('stat-completed').textContent = s.completed;
    document.getElementById('stat-cancelled').textContent = s.cancelled;
    document.getElementById('stat-today').textContent = s.todayCount;

    // Recent table
    renderBookingsTable(data.bookings, 'recentBookingsBody', true);
  } catch (e) {
    document.getElementById('recentBookingsBody').innerHTML =
      '<div class="empty-state"><i class="fas fa-wifi"></i><p>Server se connect nahi hua</p></div>';
  }
}

// ============================================================
// LOAD ALL BOOKINGS
// ============================================================
async function loadAllBookings() {
  document.getElementById('allBookingsBody').innerHTML =
    '<div class="loading"><div class="spinner"></div><br>Loading...</div>';

  const status = document.getElementById('filterStatus').value;
  const branch = document.getElementById('filterBranch').value;
  const date = document.getElementById('filterDate').value;

  let query = `?limit=200`;
  if (status !== 'all') query += `&status=${status}`;
  if (branch !== 'all') query += `&branch=${encodeURIComponent(branch)}`;
  if (date) query += `&date=${date}`;

  try {
    const res = await fetch(`${BACKEND_URL}/api/admin/bookings${query}`, {
      headers: { 'Authorization': authToken }
    });
    const data = await res.json();
    if (!data.success) { logout(); return; }

    allBookingsData = data.bookings;
    document.getElementById('bookingCount').textContent = data.totalCount;
    renderBookingsTable(data.bookings, 'allBookingsBody', false);
  } catch (e) {
    document.getElementById('allBookingsBody').innerHTML =
      '<div class="empty-state"><i class="fas fa-wifi"></i><p>Server se connect nahi hua</p></div>';
  }
}

function applyFilters() { loadAllBookings(); }
function resetFilters() {
  document.getElementById('filterStatus').value = 'all';
  document.getElementById('filterBranch').value = 'all';
  document.getElementById('filterDate').value = '';
  loadAllBookings();
}

// ============================================================
// RENDER TABLE
// ============================================================
function renderBookingsTable(bookings, containerId, compact) {
  const container = document.getElementById(containerId);

  if (!bookings.length) {
    container.innerHTML = `<div class="empty-state">
      <i class="fas fa-calendar-times"></i>
      <p>Koi booking nahi mili</p>
    </div>`;
    return;
  }

  let rows = bookings.map(b => {
    const date = new Date(b.createdAt).toLocaleDateString('hi-IN', {
      day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit'
    });
    const actions = compact ? '' : `
      <div class="action-btns">
        <button class="act-btn act-confirm" onclick="openModal('${b._id}','confirmed','${escHtml(b.notes||'')}')" title="Confirm"><i class="fas fa-check"></i></button>
        <button class="act-btn act-complete" onclick="openModal('${b._id}','completed','${escHtml(b.notes||'')}')" title="Complete"><i class="fas fa-star"></i></button>
        <button class="act-btn act-cancel" onclick="openModal('${b._id}','cancelled','${escHtml(b.notes||'')}')" title="Cancel"><i class="fas fa-ban"></i></button>
        <button class="act-btn act-delete" onclick="deleteBooking('${b._id}')" title="Delete"><i class="fas fa-trash"></i></button>
      </div>`;

    return `<tr>
      <td>
        <div class="customer-name">${escHtml(b.name)}</div>
        <div class="customer-phone"><i class="fas fa-phone" style="font-size:10px;margin-right:4px;"></i>${escHtml(b.phone)}</div>
      </td>
      <td style="color:rgba(255,255,255,0.7)">${escHtml(b.service)}</td>
      <td style="color:rgba(255,255,255,0.6)">${escHtml(b.branch)}</td>
      <td style="color:rgba(255,255,255,0.5);font-size:12px">${escHtml(b.date)}</td>
      <td><span class="badge ${b.status}"><span class="badge-dot"></span>${b.status}</span></td>
      ${compact ? '' : `<td style="color:rgba(255,255,255,0.35);font-size:11px">${date}</td>`}
      ${compact ? '' : `<td>${actions}</td>`}
    </tr>`;
  }).join('');

  const headers = compact
    ? `<tr><th>Customer</th><th>Service</th><th>Branch</th><th>Date</th><th>Status</th></tr>`
    : `<tr><th>Customer</th><th>Service</th><th>Branch</th><th>Appointment</th><th>Status</th><th>Booked On</th><th>Actions</th></tr>`;

  container.innerHTML = `<table class="bookings-table"><thead>${headers}</thead><tbody>${rows}</tbody></table>`;
}

// ============================================================
// STATUS MODAL
// ============================================================
function openModal(id, status, notes) {
  document.getElementById('editBookingId').value = id;
  document.getElementById('editStatus').value = status;
  document.getElementById('editNotes').value = notes;
  document.getElementById('statusModal').classList.add('open');
}

function closeModal() {
  document.getElementById('statusModal').classList.remove('open');
}

async function saveStatus() {
  const id = document.getElementById('editBookingId').value;
  const status = document.getElementById('editStatus').value;
  const notes = document.getElementById('editNotes').value;

  try {
    const res = await fetch(`${BACKEND_URL}/api/admin/bookings/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': authToken },
      body: JSON.stringify({ status, notes })
    });
    const data = await res.json();
    if (data.success) {
      showToast('Status update ho gaya! ✅', 'success');
      closeModal();
      loadAllBookings();
      loadDashboard();
    }
  } catch (e) {
    showToast('Update failed!', 'error');
  }
}

async function deleteBooking(id) {
  if (!confirm('Ye booking delete karni hai?')) return;
  try {
    const res = await fetch(`${BACKEND_URL}/api/admin/bookings/${id}`, {
      method: 'DELETE',
      headers: { 'Authorization': authToken }
    });
    const data = await res.json();
    if (data.success) {
      showToast('Booking delete ho gayi!', 'success');
      loadAllBookings();
      loadDashboard();
    }
  } catch (e) {
    showToast('Delete failed!', 'error');
  }
}

// ============================================================
// SERVER STATUS CHECK
// ============================================================
async function checkServerStatus() {
  const el = document.getElementById('serverStatus');
  el.innerHTML = '<span style="color:var(--gold)">Checking...</span>';
  try {
    const res = await fetch(BACKEND_URL);
    const data = await res.json();
    if (data.success) {
      el.innerHTML = `<span style="color:var(--green)">✅ Server Online! MongoDB Connected.</span>`;
    }
  } catch {
    el.innerHTML = `<span style="color:var(--red)">❌ Server Offline - Backend start karo!</span>`;
  }
}

// ============================================================
// TOAST
// ============================================================
function showToast(msg, type = 'success') {
  const t = document.getElementById('toast');
  const icon = document.getElementById('toastIcon');
  document.getElementById('toastMsg').textContent = msg;
  t.className = `toast ${type} show`;
  icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
  setTimeout(() => t.classList.remove('show'), 3500);
}

// ============================================================
// HELPERS
// ============================================================
function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// Enter key login
document.getElementById('loginPass').addEventListener('keydown', e => {
  if (e.key === 'Enter') doLogin();
});
</script>
</body>
</html>
